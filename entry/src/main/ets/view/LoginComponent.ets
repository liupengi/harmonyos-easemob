  @State message: string = '测试FD数量';
  private context1: common.Context = getContext(this);

  // 获取当前FD数量的方法
  private getFdCount(): number {
    return fileList.length;
  }


  private async increaseFdCount() {
    console.info("开始增加FD数量...");
    let targetCount = 1024;
    let currentFdCount = this.getFdCount();

    // 使用异步方式创建文件，避免阻塞UI线程
    const createFilesAsync = async () => {
      // 循环创建文件，直到FD数量超过1000
      while (currentFdCount < targetCount) {
        try {
          // 创建临时文件路径
          let filePath = this.context1.filesDir + '/temp_file_' + currentFdCount + '.txt';
          // 以读写方式打开文件，这会创建一个新的FD
          let fileObj = fs.openSync(filePath, fs.OpenMode.READ_WRITE | fs.OpenMode.CREATE);
          fileList.push(fileObj); // 保存文件对象，防止被回收

          currentFdCount = this.getFdCount();
          ChatLog.d("当前FD数量: " + currentFdCount);
          
          // 使用异步延迟避免阻塞
          await new Promise<void>(resolve => setTimeout(resolve, 1));
        } catch (error) {
          ChatLog.d("打开文件失败: " + error.message);
          break;
        }
      }

      if (currentFdCount >= targetCount) {
        ChatLog.d("成功达到目标FD数量: " + currentFdCount);
      } else {
        ChatLog.d("未能达到目标FD数量，当前: " + currentFdCount);
      }
    };

    // 异步执行文件创建
    await createFilesAsync();
  }

